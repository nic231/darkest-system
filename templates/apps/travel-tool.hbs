<div class="travel-tool-container">

  <div class="travel-now">
    <div class="travel-now-time">{{#if isFixedRegion}}{{phaseLabel}}{{else}}{{time}}{{/if}}</div>
    <div class="travel-now-day">Day {{day}}{{#unless isFixedRegion}} · {{phaseLabel}}{{/unless}}</div>
    <div class="travel-now-light">
      {{#if isFixedRegion}}
        The sun never rises here.
      {{else if merged}}
        Dusk and night have merged — no true daylight remains.
      {{else}}
        ~{{daylightHours}}h of true daylight in this day.
      {{/if}}
    </div>
    <button type="button" class="clock-reset" title="Set the day and time directly">
      <i class="fas fa-pen"></i> Set day &amp; time
    </button>
  </div>

  {{#if hasRoutes}}
  <div class="travel-plan">
    <div class="travel-plan-head">Plan a journey</div>
    <div class="travel-row">
      <div class="travel-group">
        <label>From</label>
        <select name="planFrom">
          {{#each locations}}
          <option value="{{slug}}"{{#if (eq slug ../originSlug)}} selected{{/if}}>{{title}}</option>
          {{/each}}
        </select>
      </div>
      <div class="travel-group">
        <label>To</label>
        <select name="planTo">
          <option value="">— choose —</option>
          {{#each locations}}
          <option value="{{slug}}">{{title}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <button type="button" class="plan-find">
      <i class="fas fa-route"></i> Work out the route
    </button>
  </div>

  <div class="birdsongs">
    <div class="birdsongs-head">Birdsongs known <span class="birdsongs-hint">(opens secret trails)</span></div>
    <div class="birdsong-list">
      {{#each birdsongs}}
      <button type="button" class="birdsong-toggle{{#if known}} known{{/if}}" data-bird="{{key}}">
        <i class="fas {{#if known}}fa-feather{{else}}fa-feather-pointed{{/if}}"></i> {{label}}
      </button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if hasLegs}}
  <div class="travel-legs">
    <div class="travel-legs-head">
      Journey{{#if legTotal}} · {{legTotal}}{{/if}}
      <button type="button" class="leg-clear" title="Clear the whole journey">
        <i class="fas fa-times"></i>
      </button>
    </div>
    {{#each legs}}
    <div class="travel-leg">
      <span class="travel-leg-name">{{label}}</span>
      <span class="travel-leg-time">{{duration}}</span>
      <button type="button" class="leg-remove" data-index="{{index}}" title="Remove this leg">
        <i class="fas fa-minus"></i>
      </button>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if hasRoutes}}
  <div class="travel-group">
    <label>{{#if hasLegs}}Continue from {{originName}}{{else}}Route from {{#if originName}}{{originName}}{{else}}here{{/if}}{{/if}}</label>
    <select name="route">
      <option value="">— pick a route, or enter a distance below —</option>
      {{#each hereRoutes}}
      <option value="{{key}}">{{label}}</option>
      {{/each}}
    </select>
    {{#unless hasHereRoutes}}
    <p class="travel-no-routes">
      No routes lead out of this scene. Import the region, or enter a
      distance manually below.
    </p>
    {{/unless}}
  </div>
  {{else}}
  <p class="travel-no-routes">
    No route data loaded — enable the Darkest Woods content module for the
    book's distances, or just enter a distance manually.
  </p>
  {{/if}}

  <div class="travel-row">
    <div class="travel-group">
      <label>Distance (km)</label>
      <input type="number" name="km" min="0" step="0.1" placeholder="e.g. 13" />
    </div>
    <div class="travel-group">
      <label>or Hours</label>
      <input type="number" name="hours" min="0" step="0.25" placeholder="e.g. 2" />
    </div>
  </div>

  <div class="travel-group">
    <label>Pace</label>
    <select name="pace">
      {{#each paces}}
      <option value="{{key}}"{{#if (eq key "normal")}} selected{{/if}}>{{label}} ({{speed}} km/h)</option>
      {{/each}}
    </select>
  </div>

  <div class="travel-preview">Enter a distance or pick a route.</div>

  <div class="travel-actions">
    <button type="button" class="leg-add" title="Add this leg and keep planning">
      <i class="fas fa-plus"></i> Add leg
    </button>
    <button type="button" class="travel-go">
      <i class="fas fa-person-walking"></i> {{#if hasLegs}}Travel journey{{else}}Travel{{/if}}
    </button>
  </div>

  <div class="travel-skips">
    <span class="travel-skips-label">Or just pass time:</span>
    <button type="button" class="time-skip" data-minutes="30">30m</button>
    <button type="button" class="time-skip" data-minutes="60">1h</button>
    <button type="button" class="time-skip" data-minutes="240">4h</button>
    <button type="button" class="time-skip" data-minutes="480">8h (sleep)</button>
  </div>

</div>
